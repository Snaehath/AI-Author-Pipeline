{
  "experiment_id": "experiment_001",
  "title": "Does a Compiler Make a Small Model Better?",
  "description": "Controlled ablation comparing 1.5B Baseline, 1.5B Stateful, and 1.5B Compiler-Guided BoN",
  "model": {
    "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
    "adapter_path": "models/story_lora_adapter",
    "device": "auto"
  },
  "hyperparameters": {
    "seed": 42,
    "temperature": 0.7,
    "top_p": 0.9,
    "max_new_tokens": 600,
    "repetition_penalty": 1.1
  },
  "search": {
    "num_candidates": 3,
    "lambda_efficiency": 0.15,
    "warning_penalty": 0.05,
    "allow_targeted_repair": true
  },
  "quality_weights": {
    "style": 0.35,
    "dialogue": 0.30,
    "comedy": 0.20,
    "curiosity": 0.15
  },
  "systems": [
    {
      "id": "baseline",
      "name": "Baseline (1.5B)",
      "compiler_guided": false,
      "state_managed": false,
      "num_candidates": 1
    },
    {
      "id": "stateful",
      "name": "Stateful (1.5B)",
      "compiler_guided": false,
      "state_managed": true,
      "num_candidates": 1
    },
    {
      "id": "bon",
      "name": "Compiler-Guided BoN (1.5B)",
      "compiler_guided": true,
      "state_managed": true,
      "num_candidates": 3
    }
  ]
}
