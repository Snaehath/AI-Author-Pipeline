{
  "base_model_path": "models/Qwen2.5-1.5B-Instruct",
  "fallback_model_id": "Qwen/Qwen2.5-1.5B-Instruct",
  "output_dir": "models/story_lora_adapter",
  "train_dataset_path": "datasets/train.jsonl",
  "val_dataset_path": "datasets/val.jsonl",
  "use_4bit": true,
  "lora": {
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj", "k_proj", "v_proj", "o_proj",
      "gate_proj", "up_proj", "down_proj"
    ],
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 2e-4,
    "max_seq_length": 512,
    "num_train_epochs": 2.0,
    "warmup_ratio": 0.05,
    "fp16": false,
    "bf16": true,
    "gradient_checkpointing": true,
    "optim": "paged_adamw_8bit",
    "logging_steps": 5,
    "save_strategy": "epoch",
    "eval_strategy": "epoch"
  }
}
